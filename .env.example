# PostgreSQL connection string (Neon pooled connection recommended).
# Leave empty locally to use the embedded PGlite database in ./.data
DATABASE_URL=

# Secret required by POST /api/admin/refresh (min 16 characters).
ADMIN_SECRET=

# Optional: override the User-Agent used for ingestion requests.
INGEST_USER_AGENT=

# Optional: authorised JSON rate feeds for banks that cannot be collected from
# their public website (see README, "Partner feeds"). HTTPS URLs only.
SOURCE_FEED_KAPITAL_URL=
SOURCE_FEED_PASHA_URL=
SOURCE_FEED_XALQ_URL=
SOURCE_FEED_ATB_URL=
SOURCE_FEED_TURAN_URL=

# AI research assistant (optional). Without a key the assistant shows retrieved
# database evidence only.
ANTHROPIC_API_KEY=
AI_PROVIDER=
AI_MODEL=
# Maximum model calls per day across all users.
AI_DAILY_LIMIT=200
