{
  "name": "az-finance-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server/dev.ts",
    "start": "tsx server/dev.ts --prod",
    "build": "npm run typecheck && vite build",
    "vercel-build": "tsx scripts/migrate.ts --if-configured && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "ingest": "tsx scripts/ingest.ts",
    "admin:grant": "tsx scripts/admin.ts grant",
    "admin:revoke": "tsx scripts/admin.ts revoke",
    "report": "tsx scripts/report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/functions": "^3.11.4",
    "@vercel/schedules": "^0.0.3",
    "cheerio": "^1.2.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "fast-xml-parser": "^5.12.1",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "recharts": "^3.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "zod": "$zod"
  }
}
